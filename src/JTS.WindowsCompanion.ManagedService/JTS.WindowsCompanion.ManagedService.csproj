<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>JTS.WindowsCompanion</RootNamespace>
    <AssemblyName>JTS.WindowsCompanion.ManagedService</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);JTS_MANAGED_SERVICE_DEBUG_CONSOLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JTS.WindowsCompanion.Core\JTS.WindowsCompanion.Core.csproj" />
    <ProjectReference Include="..\JTS.WindowsCompanion.Windows\JTS.WindowsCompanion.Windows.csproj" />
  </ItemGroup>
</Project>
