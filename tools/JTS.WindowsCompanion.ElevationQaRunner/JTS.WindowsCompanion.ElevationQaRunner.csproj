<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>JTS.WindowsCompanion.ElevationQaRunner</RootNamespace>
    <!-- Broker requires the Agent role name. QA uses a separate diagnostic key/manifest,
         never a production release key or distributable Agent image. -->
    <AssemblyName>JTS.WindowsCompanion.Agent</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JTS.WindowsCompanion.Core\JTS.WindowsCompanion.Core.csproj" />
    <ProjectReference Include="..\..\src\JTS.WindowsCompanion.Windows\JTS.WindowsCompanion.Windows.csproj" />
  </ItemGroup>
</Project>
